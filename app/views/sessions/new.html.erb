<% content_for :title, "Log in" %>

<section class="panel">
  <p class="eyebrow">Account</p>
  <h1>Log in</h1>
  <p class="lede">Use the email and password for your account.</p>

  <%= form_with url: session_path, class: "stack" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address] %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Your password", maxlength: 72 %>
    </div>

    <%= form.button "Log in", class: "button button-primary", name: nil %>
  <% end %>

  <p class="fine-print"><%= link_to "Forgot password?", new_password_path %></p>
</section>
